{
  "jules-pet-bridge": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/hook_bridge.py",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./scripts/hook_bridge.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/hook_bridge.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/hook_bridge.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python ./scripts/hook_bridge.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./scripts/hook_bridge.py",
        "timeout": 5
      }
    ]
  }
}
